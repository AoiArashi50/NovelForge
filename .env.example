# Database
DATABASE_URL=postgresql://novelforge:your_password@db:5432/novelforge

# DeepSeek (chat completions only — no embedding API)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Embedding provider (OpenAI-compatible format required)
# Options: OpenAI    (https://api.openai.com/v1, text-embedding-3-small, 1536)
#          阿里百炼  (https://dashscope.aliyuncs.com/compatible-mode/v1, text-embedding-v4, 1536)
#          SiliconFlow (https://api.siliconflow.cn/v1, BAAI/bge-m3)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# App
NODE_ENV=production

# DB Password (for docker-compose)
DB_PASSWORD=your_secure_password
